# ========================================================
# MVD ECOSYSTEM (PHOTO PICKER SUITE) - ENVIRONMENT CONFIG
# Copy to .env in this folder before running docker compose
# ========================================================

# Host Port Mapping
BACKEND_PORT=3000
ADMIN_PORT=3001
WEB_PORT=8080

# Public API Endpoints (Used by Web & Admin build)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
VITE_API_URL=https://api.yourdomain.com

# MongoDB Atlas Connection URI
# Ensure you append the database name (e.g. /photodb?retryWrites=true&w=majority)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/photodb?retryWrites=true&w=majority

# Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# SMTP Email (For OTP & notifications)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cloudinary Storage (For album showcase & dynamic assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
