# ==============================================================================
# MVD PHOTO PICKER SUITE - PRODUCTION ENVIRONMENT CONFIGURATION
# File này chứa toàn bộ biến môi trường cho Docker Compose & các bên thứ 3 (3rd-party APIs).
# DevOps copy file này thành: .env (đặt cùng thư mục với docker-compose.yml)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CỔNG MẠNG HOST (MAPPING PORTS)
# ------------------------------------------------------------------------------
BACKEND_PORT=3000
ADMIN_PORT=3001
WEB_PORT=8080

# ------------------------------------------------------------------------------
# 2. PUBLIC API ENDPOINTS (Dành cho Web Showcase & Admin Dashboard build time)
# Thay bằng Domain thật của server (ví dụ: https://api.mvdstudio.vn)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
VITE_API_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# 3. DATABASE: MONGODB ATLAS (BẮT BUỘC)
# Thay username, password và cluster URI của MongoDB Atlas.
# Đảm bảo có tên database (vd: /photodb) ở cuối URL.
# ------------------------------------------------------------------------------
DATABASE_URL=mongodb+srv://ougvnit2_db_user:qdwatxOV9qLYqpy7@cluster0.jxyj7cb.mongodb.net/photodb?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. BẢO MẬT & XÁC THỰC (JWT AUTHENTICATION)
# Khóa bí mật dùng để mã hóa Access Token & Refresh Token của User / Admin.
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars

# ------------------------------------------------------------------------------
# 5. CLOUDINARY CDN (LƯU TRỮ VÀ PHÂN PHỐI ẢNH SHOWCASE / ALBUM)
# Dùng để upload và render ảnh mẫu, benchmark, slider động trên trang web.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=durk6op3k
CLOUDINARY_API_KEY=117489174194911
CLOUDINARY_API_SECRET=VjgJGjHDAru7rgXQ-teDrm8e1gM
# CLOUDINARY_URL=cloudinary://117489174194911:VjgJGjHDAru7rgXQ-teDrm8e1gM@durk6op3k

# ------------------------------------------------------------------------------
# 6. DỊCH VỤ EMAIL (GỬI MÃ OTP & MÃ BẢN QUYỀN CHO KHÁCH HÀNG)
# Hỗ trợ linh hoạt: Gmail SMTP, Resend hoặc Brevo.
# ------------------------------------------------------------------------------
# Cách A: Dùng Gmail SMTP (Khuyên dùng mặc định)
SMTP_USER=ougvn.it2@gmail.com
SMTP_PASS=syqs njfa jyhb ufas
EMAIL_FROM=MVD Studio <ougvn.it2@gmail.com>

# Cách B: Dùng Resend API (Nếu có tài khoản Resend)
RESEND_API_KEY=

# Cách C: Dùng Brevo API (Nếu có tài khoản Brevo)
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 7. CỔNG THANH TOÁN SEPAY & VIETQR (TỰ ĐỘNG KÍCH HOẠT KEY BẢN QUYỀN)
# Khi khách chuyển khoản qua mã QR, SePay gửi Webhook về Backend để duyệt đơn.
# ------------------------------------------------------------------------------
# API Key xác thực Webhook từ SePay (Lấy trên dashboard my.sepay.vn)
SEPAY_WEBHOOK_API_KEY=

# Thông tin tài khoản ngân hàng nhận tiền (để sinh mã VietQR động)
# BANK_BIN: Mã định danh ngân hàng (VD: 970422 - MBBank, 970436 - Vietcombank, 970415 - VietinBank...)
BANK_BIN=970422
BANK_ACCOUNT_NO=0869528304
BANK_ACCOUNT_NAME=DUONG MINH VUONG

# ------------------------------------------------------------------------------
# 8. CẤU HÌNH HỆ THỐNG
# Tự động làm mới phiên làm việc vào đúng 00:00 (giờ Việt Nam GMT+7)
# ------------------------------------------------------------------------------
ENABLE_INTERNAL_CRON=true
