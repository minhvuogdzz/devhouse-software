{
  "name": "devhouse-software-monorepo",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web,admin\" -c \"blue,green,magenta\" \"yarn workspace @devhouse/api dev\" \"yarn workspace @devhouse/web dev\" \"yarn workspace @devhouse/admin dev\"",
    "build": "yarn workspaces foreach --all --parallel run build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^3.0.0"
  }
}
